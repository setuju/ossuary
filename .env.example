 # ═══════════════════════════════════════════════════════════════
 #  OSSUARY — Environment Variables
 #  Copy to .env:  cp .env.example .env
 #  Never commit .env — it's in .gitignore
 # ═══════════════════════════════════════════════════════════════

 # ─── LLM PROVIDERS ─────────────────────────────────────────────

 # Ollama Cloud — free tier, no credit card
 # Get key at https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1

# Google AI Studio (Gemini API) — free tier for gemma-4-31b-it
# Get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter — free tier for google/gemma-4-31b-it:free
# Get key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── VOICE (ELEVENLABS) ────────────────────────────────────────
# ElevenLabs — free 10K credits/month
# Get key at https://elevenlabs.io
ELEVENLABS_API_KEY=
# Set to voice ID from your ElevenLabs account. Recommended: Adam
# List voices: GET https://api.elevenlabs.io/v1/voices
ELEVENLABS_VOICE_ID=
# Credit saver: set to "true" to skip ElevenLabs calls during testing
# Set to "false" ONLY when recording the final demo
DISABLE_ELEVENLABS=true

# ─── SEARCH & MEMORY ──────────────────────────────────────────
# SerpApi — free 250 searches/month
# Get key at https://serpapi.com
SERPAPI_KEY=

# Backboard — free credit
# Get key at https://app.backboard.io
BACKBOARD_API_KEY=

# ─── OBSERVABILITY ────────────────────────────────────────────
# Sentry — https://sentry.io
SENTRY_DSN=
# Vite exposes this to browser via import.meta.env.VITE_SENTRY_DSN
VITE_SENTRY_DSN=

# ─── PERSISTENCE ──────────────────────────────────────────────
# MongoDB Atlas — https://mongodb.com/atlas
# Format: mongodb+srv://user:pass@cluster.mongodb.net/ossuary?retryWrites=true&w=majority
MONGODB_URI=

# TigerData (TimescaleDB) — https://console.cloud.tigerdata.com
# Format: postgres://user:pass@host:port/db
TIGERDATA_URL=

# ─── WHOIS FALLBACKS (OPTIONAL) ───────────────────────────────
# IP2WHOIS — https://ip2whois.com (free 500/month)
IP2WHOIS_API_KEY=
# WhoisXMLAPI — https://whois-history.whoisxmlapi.com
WHOISXMLAPI_API_KEY=

# ─── FRONTEND API URL (VERCEL ONLY) ───────────────────────────
# Leave empty for local dev (relative paths)
# Set to Render backend URL in production Vercel
# VITE_API_URL=https://ossuary-backend.onrender.com

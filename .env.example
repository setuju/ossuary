# Ollama Cloud — free tier, no CC. Get key at https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1

# Google AI Studio (Gemini API) — free tier for gemma-4-31b-it.
# Get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter — free tier for google/gemma-4-31b-it:free.
# Get key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Sentry backend (Node.js) — captures api/*.ts events with tags.kind=paranormal
SENTRY_DSN=

# Sentry frontend (React) — captures browser errors and React crashes.
# Vite exposes this to the browser via import.meta.env.VITE_SENTRY_DSN.
# Same DSN as SENTRY_DSN is fine for hackathon use.
VITE_SENTRY_DSN=

# Backboard — https://app.backboard.io (free credit)
BACKBOARD_API_KEY=

# ElevenLabs — https://elevenlabs.io (free 10K credits/month)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=vflhOcwDlonnVFj3wJqz

# SerpApi — https://serpapi.com (free 250 searches/month)
SERPAPI_KEY=
